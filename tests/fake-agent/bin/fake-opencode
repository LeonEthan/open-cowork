#!/usr/bin/env node
/**
 * fake opencode CLI 包装（ticket #22）：driver 以真实 `opencode serve` 方式 spawn 本文件，
 * 转发到 fake agent harness 并锁定 opencode-sse wire 格式。
 * （cli.mjs 只认 --format 旗标；真实 CLI 没有此旗标，故用本包装隔离。）
 */
import { fileURLToPath } from 'node:url';

process.argv.splice(2, 0, '--format', 'opencode-sse');
await import(fileURLToPath(new URL('../cli.mjs', import.meta.url)));
